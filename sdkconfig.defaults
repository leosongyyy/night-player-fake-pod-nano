# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.4 Project Minimal Configuration
#
CONFIG_IDF_TARGET="esp32s3"
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_UI_COVER_FLASH=y
# 音频 DAC 芯片（构建期二选一，配置项定义见 main/Kconfig.projbuild 的
# "音频 DAC 芯片选择"）：这里声明的是**当前真实硬件**——FakePodNano 成品机为
# CS43131（I2C 控制端口 0x30 + I2S）。两项必须且只能开一个：同时开启或同时
# 关闭都会在 main/main.c 的 app_main 结尾编译报错。
# ⚠ 配置矩阵构建（idfc_buildconfig.json 的 dac_chip 维度）会在本文件之后叠加
#    sdkconfig.dac_chip.<类型>，从而切到 pcm5102；该维度目前**只影响启动日志**
#    （真正的 DAC 切换尚未实现）。
CONFIG_AUDIO_DAC_CS43131=y
# CONFIG_AUDIO_DAC_PCM5102 is not set
CONFIG_COMPILER_ORPHAN_SECTIONS_PLACE=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n
CONFIG_HTTPD_MAX_REQ_HDR_LEN=512
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_5=y
CONFIG_ESP_NETIF_LOOPBACK=y
CONFIG_PM_ENABLE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_MEMTEST=n
# 允许任务栈分配在 PSRAM：内部 RAM 开机末期接近耗尽（实测空闲仅 4~5KB），
# 非实时后台任务（性能监视/电池日志/扫描/封面解码）改用 PSRAM 栈
# （见 core/utils/task_psram.h），内部 RAM 留给 LVGL 堆/驱动 DMA/关键任务
CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
# 主任务栈 16KB（原 8KB）：2026-10 TTF 迁移实测，app_main 里"持锁渲染首帧"
# 那条链 app_main → lv_refr_now → LVGL 绘制 → FreeType 光栅化的栈需求超过 8KB，
# 8KB 时栈溢出 12.6KB 跌进 .bss，把 esp_pm / task_wdt 的静态量写坏（详见
# ideas_and_exps/FontSystem.md §崩溃定位 与 core/fonts/ftoption_lvgl.h 的说明）。
# 光栅化器的 16KB 渲染池已通过 FT_CONFIG_OPTIONS_H 压到 4KB，所以 16KB 够用；
# 这个栈只在 app_main 期间占用，app_main 返回后随任务一起释放。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_BBPLL_RECALIB=n
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_USE_LABEL=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_LOG_COLORS=y
CONFIG_LWIP_HOOK_IP6_INPUT_NONE=y
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
CONFIG_WS_TRANSPORT=n
CONFIG_ULP_COPROC_ENABLED=y
# ==================== LVGL 9 配置 ====================
# 自 LVGL 8.4 迁移到 9.4，若干 Kconfig 项已改名/移除（详见
# ideas_and_exps/LVGL9_MIGRATION.md 的"配置项对照"表）：
#   LV_COLOR_16_SWAP          → 已移除，改由移植层在 flush 回调里调用
#                               lv_draw_sw_rgb565_swap()（见 core/ui/lvgl_port.c）
#   LV_COLOR_SCREEN_TRANSP    → 已移除（v9 由屏幕/图层的 bg_opa 表达）
#   LV_MEM_CUSTOM             → LV_USE_CLIB_MALLOC（下面的 choice）
#   LV_MEMCPY_MEMSET_STD      → LV_USE_CLIB_STRING（下面的 choice）
#   LV_DISP_DEF_REFR_PERIOD   → LV_DEF_REFR_PERIOD
#   LV_INDEV_DEF_READ_PERIOD  → 已移除（v9 输入设备复用 LV_DEF_REFR_PERIOD）
#   LV_USE_LARGE_COORD        → 已移除（v9 的坐标天然是 int32_t）
# 像素格式：RGB565（LV_COLOR_DEPTH 默认为 16，与本板 16bpp QSPI 面板一致）
# 内存：LVGL 9 支持把对象堆整个换到外部内存——用 CUSTOM 模式，
# 由 core/ui/lvgl_mem.c 实现 lv_malloc_core/lv_free_core/... 把 LVGL 的
# 对象/样式/中间绘制层全部放到 8MB PSRAM（内部 RAM 留给 DMA 绘制缓冲与
# 实时任务栈）。⚠ 不加这一条时实测开机完成内部 RAM 只剩 23 字节、
# DMA 只剩 19 字节、最大连续块为 0，会引发 SD 读失败与 newlib 建锁 abort。
# （v8 无此能力，只能用 LV_MEM_CUSTOM 走标准 malloc = 内部 RAM）
CONFIG_LV_USE_CUSTOM_MALLOC=y
# 字符串函数：用标准 C 的 memcpy/memset（对应 v8 的 LV_MEMCPY_MEMSET_STD=y）
CONFIG_LV_USE_CLIB_STRING=y
# 刷新周期：v9 显示刷新与输入设备轮询共用这一个周期（原先两个 33ms）
CONFIG_LV_DEF_REFR_PERIOD=33
CONFIG_LV_DPI_DEF=160
# v9 起性能监视器挂在 SYSMON 之下（SYSMON 默认 n，不显式打开则下面的
# LV_USE_PERF_MONITOR 会被 Kconfig 静默丢弃，屏幕角落就没有 FPS 了）
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
# LVGL 混合函数是否进 IRAM（2026-10-16 内存审计，见
# ideas_and_exps/IRAM_AUDIT_LVGL9.md §5 P0）：LVGL 9 把软件混合按颜色格式拆成
# 多份并整份打上 LV_ATTRIBUTE_FAST_MEM，开启本项会让约 82.8KB 代码进 IRAM ——
# 而 ESP32-S3 上 IRAM 与内部 DRAM 是同一块 SRAM 的两个别名（heap/port/esp32s3/
# memory_layout.c 的 soc_memory_regions 成对给出 0x3FC8xxxx ↔ 0x4037xxxx），
# 这 82.8KB 会**逐字节**从内部 DRAM 堆里扣掉（map 里的 .dram0.dummy 就是它）。
# 这就是"LVGL 对象都搬去 PSRAM 了、可用内部 RAM 却不见涨"的原因。
#   · 关闭后实测（同机同日只改这一行）：内部 RAM 稳态 23.5KB → 106.7KB、
#     开机完成最大连续块 3.5KB → 31.7KB，真机实测帧率只掉约 1 帧；代价是代码
#     进 .flash.text，再由 CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y 启动时拷进 PSRAM
#     执行（IDF 原文：PSRAM 比 flash 快），所以是"IRAM→PSRAM"而非"→慢速 flash"。
#   · 开启时若配合下面的颜色格式裁剪，IRAM 开销可从 82.8KB 压到约 44KB。
# 【对比实验值】临时改回 y，用于测"blend 留在 IRAM + 裁掉多余颜色格式"的组合。
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
#
# 颜色格式裁剪：LVGL 9 默认打开全部 10 种格式，每种一份独立混合实现。本机屏幕
# 是 RGB565，实测真正用到的是：RGB565（屏幕/绘制缓冲/JPEG 封面）、ARGB8888
# （clip_corner 圆角帽、lv_slider 圆角分支、需要 alpha 的 simple layer）、
# RGB565A8（对象/图片旋转缩放的唯一依赖）、RGB888（水平/复杂渐变的临时源格式）。
# 下面 6 种当前 UI 无任何来源：
#   AL88 / L8 / I1            —— 没有对应格式的图源
#   ARGB8888_PREMULTIPLIED    —— 无 ThorVG/Lottie 时 SW 核心从不生产，纯死代码
#   XRGB8888                  —— 仅在 LV_COLOR_DEPTH==32 时才是原生格式
#   A8                        —— 只管"被旋转缩放的 A8 图源"；正文文字的字形位图
#                                是当蒙版用的，不走这个开关
# ⚠ 缺格式的失败方式全是"静默"的：目标格式缺失 = 整块不画且无任何日志；
# 源格式缺失 = 一条 LV_LOG_WARN 后不画；变换缺失 = 警告 + 拿未初始化缓冲混合
# （花屏）。排查手段：idfc monitor --grep "not enabled" / --grep "Not supported source"。
# 必刷验证点：下拉控制中心（clip_corner）+ 拖动竖条、播放页拖进度条、
# 播放设置页、全屏设置菜单、EQ 弹窗、Toast、息屏→亮屏（全屏重刷）。
# CONFIG_LV_DRAW_SW_SUPPORT_XRGB8888 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888_PREMULTIPLIED is not set
# CONFIG_LV_DRAW_SW_SUPPORT_L8 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_AL88 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_A8 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_I1 is not set
#
# 不编译 LVGL 自带的 examples/demos：CONFIG_LV_BUILD_EXAMPLES 默认 y，会让 lvgl
# 组件递归编译 examples/ 下全部 250 个 .c。实测这纯属浪费——这些函数无人引用，
# 最终被 --gc-sections 全部丢弃（nm 在 ELF 里找不到任何 lv_example/lv_demo 符号，
# map 里 0 处出现），既不占 flash 也不占 RAM，只吃全量编译时间。
# LV_BUILD_DEMOS 本身不编译任何文件（12 个 LV_USE_DEMO_* 全为 n 时 demos/ 下
# 一个 .c 都不进源列表），一并关掉只为少一堆配置项。
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
# 坐标：v9 的 lv_coord_t 固定为 int32_t，不再需要 LV_USE_LARGE_COORD。
# 虚拟列表真实内容高度 = 条目数 × 行高，600+ 歌曲即超过 int16 上限
# （611×56=34216），v9 天然支持（v8 时代曾因误删该配置导致长列表滚不到底部）
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_18=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# ---------------------------------------------------------------------------
# TTF 矢量字体（FreeType，2026-10 字体迁移）
# ---------------------------------------------------------------------------
# 界面字体不再内嵌位图，改为从 font 分区（partitions.csv，裸二进制 4MiB）
# 读取 spiffs/system.ttf（当前 Droid Sans Fallback），按需光栅化字形：
#   CONFIG_LV_USE_FREETYPE          编入 LVGL 的 src/libs/freetype/*，
#                                   提供 lv_freetype_font_create()。⚠ 它只编译
#                                   源码、不加依赖，ft2build.h 的 include 与
#                                   FT_* 符号靠 main/CMakeLists.txt 把
#                                   espressif/freetype 链接给 lvgl 组件；
#                                   初始化由 lv_init() 自动完成（见下）。
#   CONFIG_LV_FREETYPE_USE_LVGL_PORT 文件访问走 lv_fs（我们用自定义驱动读 font
#                                   分区，盘符 F:）、内存分配走 lv_malloc
#                                   （即 core/ui/lvgl_mem.c → PSRAM，不占内部 RAM）
#   CONFIG_LV_FREETYPE_CACHE_FT_GLYPH_CNT
#                                   字形缓存条目数基准，**同时管两个 LRU 缓存**
#                                   （lv_freetype.c 的 freetype_on_font_create）：
#                                     · 字形度量缓存 glyph_cache = 本值 × 2
#                                     · **位图缓存 draw_data_cache = 本值**
#                                   位图缓存才是关键：24px 汉字一字约 0.5KB，
#                                   1024 条 ≈ 0.5MB，全部落在 PSRAM（不占内部 RAM）。
#                                   2026-10 实测：256 时"列表快速重绑"约 10fps
#                                   （位图字体时代同场景约 20fps，差距全在未命中
#                                   时的现场光栅化），调到 1024 后重复滚动基本
#                                   全命中。若 PSRAM 吃紧可回落 512。
# ⚠ 应用侧**不要**调 lv_freetype_init()：LVGL 9.4 的 lv_init() 已经初始化过
#   FreeType（lv_init.c 里带 LV_FREETYPE_CACHE_FT_GLYPH_CNT），重复调用会
#   LV_LOG_WARN("freetype already initialized") 并返回 LV_RESULT_INVALID，
#   把它当致命错误就会表现为"字体文件完全正常却报字体加载失败"。
#   （参考项目 OtoClock 踩过这个坑，见 ideas_and_exps/FontSystem.md）
CONFIG_LV_USE_FREETYPE=y
CONFIG_LV_FREETYPE_USE_LVGL_PORT=y
CONFIG_LV_FREETYPE_CACHE_FT_GLYPH_CNT=1024
# font 分区里烧的字体**写死**为 spiffs/system.ttf（见 main/Kconfig.projbuild 的说明与
# 2026-10-25 起的刷入文档 ideas_and_exps/FONT_FLASH.md）：当前内容是 **Droid Sans Fallback**
# （3.55MiB / 50951 字形 / 24px 行高 31、20px 行高 26，AOSP Apache-2.0，许可文本入库在
# spiffs/DroidSansFallback-LICENSE.txt）。2026-10 实测它同一手势下滚动帧率明显高于此前的
# MiSans：单字形轮廓数据只有 MiSans 的约 1/4（光栅化更便宜 + flash 局部性更好），故弃用
# MiSans、固定使用 Droid。
# ⚠ 换字体：用新字体文件**改名覆盖** spiffs/system.ttf，然后 `idfc build` + **手动刷字体分区**
#   （`esptool.exe --chip esp32s3 -p COMx write_flash 0x800000 spiffs/system.ttf`；字体不在
#   固件里，普通 `idfc flash` 不会更新它）；启动日志的 "N 张表，M 个字形" 可确认生效的是哪份。

# 完整固件启动耗时较大，跳过校验来提高启动速度
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
