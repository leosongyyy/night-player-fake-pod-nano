# This file was generated using idf.py save-defconfig or menuconfig [D] key. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 6.1 Project Minimal Configuration
#
# 2026-11 硬件平台迁移：目标从 ESP32-S3 改为 **ESP32-S31**（FakePodNano Pro V1，
# 见 ideas_and_exps/reference_docs/hardware_v1.md）。S31 是 IDF 6.1 的 preview
# 目标（tools/idf_py_actions/constants.py 的 PREVIEW_TARGETS），320MHz 双核
# RISC-V + LP core、16MB Flash + 16MB Octal PSRAM、512KB SRAM。
CONFIG_IDF_TARGET="esp32s31"
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
# ⚠ ESP32-S31 是 IDF 6.1 的 preview 目标，IDF 给 preview/bringup 目标默认打开
# CONFIG_IDF_ENV_BRINGUP=y，而它会把 CONFIG_ESPTOOLPY_NO_STUB 默认设为 y。
# 无 stub 时 esptool 只能走 ROM loader 的 1KB 小块写：实测 1.79MB 固件要 113 秒
# （约 130 kbit/s，日志里每行只前进 1KB）。S31 的下载 stub 实测可用
#（esptool flash_id 能正常 "Uploading stub flasher... Stub flasher running"），
# 故这里显式关掉 NO_STUB（用户设置值优先于 bringup 默认），恢复 64KB 块写。
CONFIG_ESPTOOLPY_NO_STUB=n
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_UI_COVER_FLASH=y
# 孤立段（orphan sections）处理：IDF 6.0 起默认值从"容忍"收紧为 **ERROR**
# （CONFIG_COMPILER_ORPHAN_SECTIONS_ERROR，见 IDF 根 Kconfig 的 choice）。
# 本工程历史上一直用 PLACE（静默放置），迁移到 6.1 时改为 **WARNING**：
# 行为与 PLACE 相同（仍然放置，不会链接失败），但会打印是哪些段，
# 便于发现"内存映射配置有问题"（这正是 IDF 文档不推荐 PLACE 的原因）。
# 若日后又想静默，把本行换回 CONFIG_COMPILER_ORPHAN_SECTIONS_PLACE=y。
CONFIG_COMPILER_ORPHAN_SECTIONS_WARNING=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=n
CONFIG_HTTPD_MAX_REQ_HDR_LEN=512
CONFIG_ESP_BROWNOUT_DET_LVL_SEL_5=y
CONFIG_ESP_NETIF_LOOPBACK=y
CONFIG_PM_ENABLE=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
# S31 的 PSRAM 时钟档位是 40/100/200/250MHz（Kconfig.spiram 里没有 80M 档）；
# 模组为 16MB Octal PSRAM，取 200MHz（默认档，稳定优先）。
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_MEMTEST=n
# 允许任务栈分配在 PSRAM：内部 RAM 开机末期接近耗尽（实测空闲仅 4~5KB），
# 非实时后台任务（性能监视/电池日志/扫描/封面解码）改用 PSRAM 栈
# （见 core/utils/task_psram.h），内部 RAM 留给 LVGL 堆/驱动 DMA/关键任务
# ⚠ IDF 6.1 改名：CONFIG_SPIRAM_ALLOW_STACK_EXTERNAL_MEMORY →
#   CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM（见 v6.1
#   components/freertos/sdkconfig.rename）。旧名在 6.1 会被当成已废弃项自动
#   映射，但生成 sdkconfig 时会打警告，这里直接改用新名。
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
# S31：CPU 最高 320MHz（CPLL），默认即 320MHz。屏幕 UI 与 MP3 解码分核，
# 低频档位不需要（esp_pm 在 power_service 里按 320/80MHz 固定）。
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
# S31 的 L1 D-Cache 行宽固定 64B（Kconfig.cache 里没有可选项），
# 原先的 CONFIG_ESP32S3_DATA_CACHE_LINE_64B 已随平台迁移删除。
# 主任务栈 16KB（原 8KB）：2026-10 TTF 迁移实测，app_main 里"持锁渲染首帧"
# 那条链 app_main → lv_refr_now → LVGL 绘制 → FreeType 光栅化的栈需求超过 8KB，
# 8KB 时栈溢出 12.6KB 跌进 .bss，把 esp_pm / task_wdt 的静态量写坏（详见
# ideas_and_exps/FontSystem.md §崩溃定位）。2026-11 已改回位图字体（NPF1，
# 不再光栅化），16KB 继续保留（未重新收紧）；这个栈只在 app_main 期间占用，
# app_main 返回后随任务一起释放。若内部 RAM 吃紧，可实测后回落到 8KB。
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_ESP_SYSTEM_BBPLL_RECALIB=n
CONFIG_ESP_TIMER_SUPPORTS_ISR_DISPATCH_METHOD=y
CONFIG_ESP_WIFI_STATIC_TX_BUFFER=y
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_CODEPAGE_936=y
CONFIG_FATFS_API_ENCODING_UTF_8=y
CONFIG_FATFS_USE_LABEL=y
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_LOG_COLORS=y
# ⚠ 以下 LWIP / WIFI / mbedtls 配置项：2026-11 起 wifi/bt/lwip/wpa_supplicant
#   等组件已被 COMPONENTS 白名单移出构建（见根 CMakeLists.txt），这些项在当前
#   构建里**不再起作用**；保留它们是因为随时可能重新引入，删掉反而要多记一笔。
#   真正仍生效的是下面的 mbedtls 两条关闭项 —— mbedtls 摘不掉（bootloader_support
#   与 nvs_flash 硬依赖，见 ideas_and_exps/MBEDTLS_BUILD_AUDIT.md），但项目不做
#   任何网络/TLS，所以证书包与 PKCS#7 纯属浪费：关掉可少编 esp_crt_bundle.c 与
#   pkcs7.c，并跳过 gen_crt_bundle.py 生成证书包这一步（零风险，量级很小）。
CONFIG_LWIP_HOOK_IP6_INPUT_NONE=y
CONFIG_MBEDTLS_ECP_FIXED_POINT_OPTIM=y
# CONFIG_MBEDTLS_CERTIFICATE_BUNDLE is not set
# CONFIG_MBEDTLS_PKCS7_C is not set
CONFIG_WS_TRANSPORT=n
# S31 的 LP core 固件当前未使用，关闭 ULP 以省掉 RTC 内存预留与 LP 镜像构建
# CONFIG_ULP_COPROC_ENABLED is not set
# ==================== LVGL 9 配置 ====================
# 自 LVGL 8.4 迁移到 9.4，若干 Kconfig 项已改名/移除（详见
# ideas_and_exps/LVGL9_MIGRATION.md 的"配置项对照"表）：
#   LV_COLOR_16_SWAP          → 已移除，改由移植层在 flush 回调里调用
#                               lv_draw_sw_rgb565_swap()（见 core/ui/lvgl_port.c）
#   LV_COLOR_SCREEN_TRANSP    → 已移除（v9 由屏幕/图层的 bg_opa 表达）
#   LV_MEM_CUSTOM             → LV_USE_CLIB_MALLOC（下面的 choice）
#   LV_MEMCPY_MEMSET_STD      → LV_USE_CLIB_STRING（下面的 choice）
#   LV_DISP_DEF_REFR_PERIOD   → LV_DEF_REFR_PERIOD
#   LV_INDEV_DEF_READ_PERIOD  → 已移除（v9 输入设备复用 LV_DEF_REFR_PERIOD）
#   LV_USE_LARGE_COORD        → 已移除（v9 的坐标天然是 int32_t）
# 像素格式：RGB565（LV_COLOR_DEPTH 默认为 16，与本板 16bpp QSPI 面板一致）
# 内存：LVGL 9 支持把对象堆整个换到外部内存——用 CUSTOM 模式，
# 由 core/ui/lvgl_mem.c 实现 lv_malloc_core/lv_free_core/... 把 LVGL 的
# 对象/样式/中间绘制层全部放到 16MB PSRAM（内部 RAM 留给 DMA 绘制缓冲与
# 实时任务栈）。⚠ 不加这一条（即走 CLIB = 标准 malloc → 内部 RAM）时实测
# 开机完成内部 RAM 只剩 23 字节、DMA 只剩 19 字节、最大连续块为 0，
# 会引发 SD 读失败与 newlib 建锁 abort（v8 没有 CUSTOM 能力，只能这样）。
# 【2026-10-16 两次复测，结论：永久保留 CUSTOM，LVGL 对象必须留在 PSRAM】
#   复测-1（方案②，blend 留 IRAM，内部 RAM 82.3KB）：ui:before app_ui_create
#   还有 86,527B 空闲，到 cover:req 掉到 23B / 最大连续块 0 / 分配块 338→1677，
#   随后 newlib 建锁失败 abort → 重启循环。
#   复测-2（方案④，关 FAST_MEM，内部 RAM 106.3KB，本项目最宽裕的配置）：
#   ui:before app_ui_create 有 112,383B，创建完 UI 只剩 7,735B、DMA 仅 19B；
#   紧接着 sdmmc_cmd: allocate_dma_buf: not enough mem（连 512B 都分配不到）
#   → 解码器起不来被判定坏曲 → 自动跳曲 + "歌曲数据损坏" toast，
#   mem_monitor 任务也建不起来（internal free=55）。
# 即 LVGL 对象堆的峰值需求 ≥105KB（若要留安全余量得 ~150KB），本项目内部 RAM
# 无论如何都装不下，CUSTOM + PSRAM 是唯一可行方案。
CONFIG_LV_USE_CUSTOM_MALLOC=y
# 对象放哪：2026-11 起**全部走 PSRAM**。S3 时代曾在两个滚动列表页创建期间把
# 热点对象钉回内部 RAM（路径B，省 1 帧差 10fps），但 S31 上该方案只钉得进约
# 20.5KB（40KB 保留线提前触发），关掉后内部 RAM 稳态 +20.5KB、最大连续块
# 31.7KB→86KB，列表快速滚动 24~36fps，真机确认可接受，故 Kconfig 开关
# CONFIG_UI_LVGL_PIN_HOT_OBJECTS 默认 n。实测见 IRAM_OBJECTS_PSRAM_S31.md。
# 字符串函数：用标准 C 的 memcpy/memset（对应 v8 的 LV_MEMCPY_MEMSET_STD=y）
CONFIG_LV_USE_CLIB_STRING=y
# 刷新周期：v9 显示刷新与输入设备轮询共用这一个周期（原先两个 33ms）
# 2026-11 S31 迁移实测：40MHz QSPI 下列表滚动已能满 30fps；改为 16ms（≈60Hz）
# 配合 80MHz QSPI 做高帧率实验（带宽 4 线 × 80MHz ≈ 32MB/s，一屏 423KB
# 约 13ms，理论上限接近 60fps）。
CONFIG_LV_DEF_REFR_PERIOD=16
CONFIG_LV_DPI_DEF=160
# v9 起性能监视器挂在 SYSMON 之下（SYSMON 默认 n，不显式打开则下面的
# LV_USE_PERF_MONITOR 会被 Kconfig 静默丢弃，屏幕角落就没有 FPS 了）
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y
# LVGL 混合函数是否进 IRAM（2026-10-16 内存审计，见
# ideas_and_exps/IRAM_AUDIT_LVGL9.md §5 P0）：LVGL 9 把软件混合按颜色格式拆成
# 多份并整份打上 LV_ATTRIBUTE_FAST_MEM，开启本项会让约 82.8KB 代码进 IRAM ——
# 而 ESP32-S3 上 IRAM 与内部 DRAM 是同一块 SRAM 的两个别名（heap/port/esp32s3/
# memory_layout.c 的 soc_memory_regions 成对给出 0x3FC8xxxx ↔ 0x4037xxxx），
# 这 82.8KB 会**逐字节**从内部 DRAM 堆里扣掉（map 里的 .dram0.dummy 就是它）。
# 这就是"LVGL 对象都搬去 PSRAM 了、可用内部 RAM 却不见涨"的原因。
#   · 关闭后实测（同机同日只改这一行）：内部 RAM 稳态 23.5KB → 106.7KB、
#     开机完成最大连续块 3.5KB → 31.7KB，真机实测帧率只掉约 1 帧；代价是代码
#     进 .flash.text，再由 CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y 启动时拷进 PSRAM
#     执行（IDF 原文：PSRAM 比 flash 快），所以是"IRAM→PSRAM"而非"→慢速 flash"。
#   · 开启时若配合下面的颜色格式裁剪，IRAM 开销可从 82.8KB 压到约 44KB。
# 【2026-10-16 定稿】保留 blend 在 IRAM：真机实测关掉它内部 RAM 虽多 83KB，
# 但 blend 会退到 PSRAM 执行；既然裁格式已把 LVGL 的 IRAM 开销从 82.8KB
# 压到 25.3KB、内部 RAM 也从 23.5KB 升到 82.3KB，就没必要再牺牲 blend 速度。
CONFIG_LV_ATTRIBUTE_FAST_MEM_USE_IRAM=y
#
# 颜色格式裁剪：LVGL 9 默认打开全部 10 种格式，每种一份独立混合实现。本机屏幕
# 是 RGB565，实测真正用到的是：RGB565（屏幕/绘制缓冲/JPEG 封面）、ARGB8888
# （clip_corner 圆角帽、lv_slider 圆角分支、需要 alpha 的 simple layer）、
# RGB565A8（对象/图片旋转缩放的唯一依赖）、RGB888（水平/复杂渐变的临时源格式）。
# 下面 6 种当前 UI 无任何来源：
#   AL88 / L8 / I1            —— 没有对应格式的图源
#   ARGB8888_PREMULTIPLIED    —— 无 ThorVG/Lottie 时 SW 核心从不生产，纯死代码
#   XRGB8888                  —— 仅在 LV_COLOR_DEPTH==32 时才是原生格式
#   A8                        —— 只管"被旋转缩放的 A8 图源"；正文文字的字形位图
#                                是当蒙版用的，不走这个开关
# ⚠ 缺格式的失败方式全是"静默"的：目标格式缺失 = 整块不画且无任何日志；
# 源格式缺失 = 一条 LV_LOG_WARN 后不画；变换缺失 = 警告 + 拿未初始化缓冲混合
# （花屏）。排查手段：idfc monitor --grep "not enabled" / --grep "Not supported source"。
# 必刷验证点：下拉控制中心（clip_corner）+ 拖动竖条、播放页拖进度条、
# 播放设置页、全屏设置菜单、EQ 弹窗、Toast、息屏→亮屏（全屏重刷）。
# CONFIG_LV_DRAW_SW_SUPPORT_XRGB8888 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_ARGB8888_PREMULTIPLIED is not set
# CONFIG_LV_DRAW_SW_SUPPORT_L8 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_AL88 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_A8 is not set
# CONFIG_LV_DRAW_SW_SUPPORT_I1 is not set
#
# 不编译 LVGL 自带的 examples/demos：CONFIG_LV_BUILD_EXAMPLES 默认 y，会让 lvgl
# 组件递归编译 examples/ 下全部 250 个 .c。实测这纯属浪费——这些函数无人引用，
# 最终被 --gc-sections 全部丢弃（nm 在 ELF 里找不到任何 lv_example/lv_demo 符号，
# map 里 0 处出现），既不占 flash 也不占 RAM，只吃全量编译时间。
# LV_BUILD_DEMOS 本身不编译任何文件（12 个 LV_USE_DEMO_* 全为 n 时 demos/ 下
# 一个 .c 都不进源列表），一并关掉只为少一堆配置项。
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
# 坐标：v9 的 lv_coord_t 固定为 int32_t，不再需要 LV_USE_LARGE_COORD。
# 虚拟列表真实内容高度 = 条目数 × 行高，600+ 歌曲即超过 int16 上限
# （611×56=34216），v9 天然支持（v8 时代曾因误删该配置导致长列表滚不到底部）
CONFIG_LV_FONT_MONTSERRAT_12=y
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_32=y
CONFIG_LV_FONT_MONTSERRAT_48=y
CONFIG_LV_FONT_DEFAULT_MONTSERRAT_18=y
CONFIG_LV_FONT_FMT_TXT_LARGE=y

# ---------------------------------------------------------------------------
# Espressif PPA 2D 加速（ESP32-S31）
# ---------------------------------------------------------------------------
# ⚠ 这里**不**启用 LVGL 自带的 PPA 绘制单元（CONFIG_LV_USE_PPA）。
#   9.4 上游的 lv_draw_ppa*.c 是独立 draw unit，在 PARTIAL 渲染下有硬伤：
#   FILL 把目标块固定画在 buffer 左上角（忽略 buf_area，每 46 行一条横黑线）、
#   非阻塞模式却立刻标记完成、每次操作同步整块缓冲。
#
# 改用**自定义 SW blend handler**（main/core/ui/lvgl_ppa_accel.c，
# Kconfig 项 CONFIG_UI_PPA_ACCEL）：对应官方固件日志
#   "PPA: register lvgl blend handle ok"
# 的做法，只把"向 RGB565 图层做图像混合"交给 PPA，文字/填充/mask 仍走 CPU。
# 实测数据与调参记录见 ideas_and_exps/PPA_ACCEL.md。
#
# 仍保留的两个对齐配置是 PPA 与 LVGL 绘制缓冲的硬要求：
CONFIG_LV_ATTRIBUTE_MEM_ALIGN_SIZE=64
CONFIG_LV_DRAW_BUF_ALIGN=64
# ⚠ 2026-11 实测结论（S31）：PPA **FILL** 每次约 285~330µs / 1.5 万像素
#   （≈50M px/s），比 320MHz CPU 的软件填充慢一个数量级。因此纯色填充
#   默认仍走 CPU（CONFIG_UI_PPA_FILL_MIN_PX=0），PPA 只用于混合。
# CONFIG_LV_USE_PPA is not set
# CONFIG_LV_USE_PPA_IMG is not set

# ---------------------------------------------------------------------------
# 系统字体：位图（NPF1 外置全字库，2026-11 从 TTF/FreeType 改回位图）
# ---------------------------------------------------------------------------
# 界面字体是 24px **位图**全字库（bpp2）：Droid Sans Fallback 的 34,461 个码位
# 离线预烘焙成 spiffs/system.npf（4.44MiB），烧进 font 分区（partitions.csv，
# 6MiB @0x600000）。运行时由 core/fonts/font_npf.c 做一次 esp_partition_mmap +
# 填 lv_font_fmt_txt_dsc_t，字形位图与 glyph_dsc 都留在 Flash（占 MMU 页、不占
# RAM）；详见 ideas_and_exps/NPF_FONT.md。
#
# 因此这里**不再有** FreeType 相关配置（CONFIG_LV_USE_FREETYPE /
# LV_FREETYPE_USE_LVGL_PORT / LV_FREETYPE_CACHE_FT_GLYPH_CNT 全部移除），也不需要
# espressif/freetype 组件。位图字体没有字形缓存、不占 PSRAM：
#   · 20px 小字体（状态栏时间/两行文字图标）用内嵌的 system_smaller_font（位图）；
#   · NPF 挂载失败时回退内嵌精简字库 system_global_font_lite（能开机，用户数据缺字）；
#   · LV_FONT_FMT_TXT_LARGE 必须保持 y（见上方）：NPF 的 glyph_dsc 是 LARGE 的
#     16B 布局、位图索引超过 20bit（4.4MB），关掉会直接读错。
# ⚠ 换字体：改 tools/font 的生成流程重新烘焙 spiffs/system.npf，然后 `idfc build`
#   + **手动刷字体分区**（`esptool.exe --chip esp32s31 -p COMx write_flash 0x600000
#   spiffs/system.npf`；字体不在固件里，普通 `idfc flash` 不会更新它）；启动日志的
#   "NPF1 全字库已挂载: 24px ... N 个字形" 可确认生效的是哪份。
#   当前字体许可文本入库在 spiffs/DroidSansFallback-LICENSE.txt（AOSP Apache-2.0）。

# 完整固件启动耗时较大，跳过校验来提高启动速度
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_ALWAYS=y
CONFIG_BOOTLOADER_SKIP_VALIDATE_IN_DEEP_SLEEP=y
