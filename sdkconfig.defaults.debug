# Debug 构建差异配置（叠加在 sdkconfig.defaults 之后，覆盖其中的默认值）
# 用途：快速烧录调试 —— 精简字体 + 非极速版封面 + 性能监视 +
#       FreeRTOS 运行时统计（performance_monitor 依赖）+ LVGL FPS 计数。
# 使用：idf.py -B build/debug -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.debug" build

# 编译优化：Performance（-O2）—— 与 release 一致（运行性能优先）
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 精简字体：仅系统 UI 用字 + ASCII，固件小、烧录快（覆盖公共默认的完整版）
# ⚠ 2026-10 起界面字体走 TTF（公共默认 CONFIG_UI_FONT_TTF=y），完整版字库已被
#    Kconfig 的 depends on !UI_FONT_TTF 屏蔽；精简版**始终编进固件**，它是
#    TTF 打不开时的回退字体。所以这里保留"不用完整版"的意图（等于回退字体用精简版）。
# CONFIG_UI_SYSTEM_FONT_FULL is not set
# 非极速版封面：2bit 索引色 default_cover，省 Flash（覆盖公共默认的极速版）
# CONFIG_UI_COVER_FLASH is not set

# LVGL 日志（**仅 debug**）：字体迁移排障用。两个都要开——LV_USE_LOG 负责编入
# 日志宏，LV_LOG_PRINTF 负责输出（LVGL 默认打印回调是空的，只开前者日志会被
# 静默丢弃）。⚠ 级别数字是反的：TRACE(0) < INFO(1) < WARN(2) < ERROR(3) < USER(4)，
# 过滤条件是 level >= LV_LOG_LEVEL，所以默认的 WARN(2) 能放行 ERROR，把它"调高"
# 到 USER(4) 反而会把 ERROR 一起过滤掉。FreeType 的失败原因（LV_LOG_ERROR）就靠
# 这一档看，遇到"字体明明在却加载失败"先看串口这里。
CONFIG_LV_USE_LOG=y
CONFIG_LV_LOG_PRINTF=y
CONFIG_LV_LOG_LEVEL_WARN=y

# 触摸区域测试（白点）与电池电压日志已改为运行时开关（设置→关于→开发者
# 选项，NVS 持久化，重启生效），不再属于构建配置差异。
# 性能监视（内存 + 双核 CPU 使用率，串口每 2s 输出）
CONFIG_PERFORMANCE_MONITOR=y
# FreeRTOS 运行时统计：performance_monitor 依赖（CPU 空闲计数器）
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# LVGL FPS 计数（屏幕角落显示刷新帧率/耗时）
CONFIG_LV_USE_PERF_MONITOR=y

# PPA 混合加速：统计默认**关**。
# ⚠ 每 500 次混合打一条日志，滑动时约 15 条/秒，而 115200 波特的 UART 打一条
#   ~10ms（ESP_LOG 是同步阻塞写），等于白扔 15% CPU —— 实测开统计会让滑动明显
#   变卡，**不要**在测性能时打开。要看数据时临时打开，看完立刻关。
# CONFIG_UI_PPA_STATS is not set

# 实验（2026-11-16 第二轮）：LVGL 绘制缓冲放 PSRAM，省约 83KB 内部 RAM。
# ⚠ 第二轮结论（2026-11-16 下午）：**默认关闭**。叠加 XIP from PSRAM 后两者
#   都能跑：内部缓冲 40fps / PSRAM 缓冲 34fps（列表快速滚动最差，0°），用户
#   选择留内部缓冲保流畅度。开关保留，需要 83KB 内部 RAM 时再打开。
# CONFIG_UI_DRAW_BUF_IN_PSRAM=y

# 堆毒化：**默认关闭**（2026-09 实测开关对比结论，见 PSRAM_TASK_STACK.md）
# Comprehensive 模式给每个分配加带调用栈的元数据头、且禁止空闲块合并，
# 实测多占约 26KB 内部 RAM 并把最大连续块从 31.7KB 压到 14.8KB——这是
# debug 版内部 RAM 紧张、任务创建失败（power_svc/rescan/performance_monitor）
# 的直接原因，release 版因此从未出现该问题。
# 需要抓堆破坏/悬垂对象崩溃时，临时改回下面两行再构建（曾用于定位坏曲播放
# 导致的 LVGL 对象崩溃）：
#   CONFIG_HEAP_POISONING_COMPREHENSIVE=y
#   # CONFIG_HEAP_POISONING_DISABLED is not set
CONFIG_HEAP_POISONING_DISABLED=y
# CONFIG_HEAP_POISONING_LIGHT is not set
# CONFIG_HEAP_POISONING_COMPREHENSIVE is not set
