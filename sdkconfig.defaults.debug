# Debug 构建差异配置（叠加在 sdkconfig.defaults 之后，覆盖其中的默认值）
# 用途：快速烧录调试 —— 精简字体 + 非极速版封面 + 性能监视 +
#       FreeRTOS 运行时统计（performance_monitor 依赖）+ LVGL FPS 计数。
# 使用：idf.py -B build/debug -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.debug" build

# 编译优化：Performance（-O2）—— 与 release 一致（运行性能优先）
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 精简字体：仅系统 UI 用字 + ASCII，固件小、烧录快（覆盖公共默认的完整版）
# CONFIG_UI_SYSTEM_FONT_FULL is not set
# 非极速版封面：2bit 索引色 default_cover，省 Flash（覆盖公共默认的极速版）
# CONFIG_UI_COVER_FLASH is not set

# 触摸区域测试（白点）与电池电压日志已改为运行时开关（设置→关于→开发者
# 选项，NVS 持久化，重启生效），不再属于构建配置差异。
# 性能监视（内存 + 双核 CPU 使用率，串口每 2s 输出）
CONFIG_PERFORMANCE_MONITOR=y
# FreeRTOS 运行时统计：performance_monitor 依赖（CPU 空闲计数器）
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# LVGL FPS 计数（屏幕角落显示刷新帧率/耗时）
CONFIG_LV_USE_PERF_MONITOR=y

# Comprehensive 堆毒化：越界写在释放时立即报 CORRUPT HEAP 并打印写入者调用
# 栈，专用于在开发/调试阶段抓取堆破坏与悬垂对象类崩溃（曾用于定位坏曲播放
# 导致的 LVGL 对象崩溃）。性能有少量开销，release 版不启用。
CONFIG_HEAP_POISONING_COMPREHENSIVE=y
# CONFIG_HEAP_POISONING_DISABLED is not set
# CONFIG_HEAP_POISONING_LIGHT is not set
