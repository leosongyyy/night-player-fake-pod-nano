# Release Candidate 构建差异配置（叠加在 sdkconfig.defaults 之后）
# 用途：调试 release 版在可用内存变小情况下的运行状况 —— 完整字体 + 极速版
#       封面（与 release 相同的内存占用，完整字体经 SPIRAM_RODATA 拷贝进
#       PSRAM 约 2.6MB），但保留调试功能（性能监视/FPS 计数），便于在低内存
#       环境下定位问题。触摸区域测试与电池电压日志已改为运行时开关
#       （设置→关于→开发者选项，NVS，默认关），不再属于构建差异。
# 使用：idf.py -B build/releasecandidate -D SDKCONFIG_DEFAULTS="sdkconfig.defaults;sdkconfig.defaults.releasecandidate" build

# 编译优化：Performance（-O2）—— 与 release 一致（公共默认已是，显式声明）
CONFIG_COMPILER_OPTIMIZATION_PERF=y

# 完整字体：与 release 一致（PSRAM 占用大，模拟 release 内存环境）
CONFIG_UI_SYSTEM_FONT_FULL=y
# 极速版封面：RGB565 真彩色 default_cover_flash（与 release 一致）
CONFIG_UI_COVER_FLASH=y

# 调试功能全部保留（同 debug）
CONFIG_PERFORMANCE_MONITOR=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
CONFIG_LV_USE_PERF_MONITOR=y

# 堆毒化：**关闭**（2026-09-10 修正）。
# debug 配置早在 2026-09 就已改成 DISABLED，本文件此前仍是 COMPREHENSIVE，
# 注释还写着"与 debug 一致"——实测这一项就让 RC 比 debug 少 18~28KB 内部 RAM，
# 并把内部 RAM 最大连续块从 30KB 级压到 2.8KB：LVGL 绘制缓冲回到 V_RES/10 后，
# app_ui_create 结束时 DMA 只剩 955B / 连续 80B → sdmmc allocate_dma_buf 失败
# → 判坏曲 → 开机跳曲；同时 4KB 的 sleep_timer 内部栈也起不来。
# 详见 ideas_and_exps/IRAM_DMA_AUDIT.md。
# 需要抓堆越界写/悬垂对象时，按下面注释临时改回 Comprehensive 再构建。
CONFIG_HEAP_POISONING_DISABLED=y
# CONFIG_HEAP_POISONING_COMPREHENSIVE is not set
# CONFIG_HEAP_POISONING_LIGHT is not set
