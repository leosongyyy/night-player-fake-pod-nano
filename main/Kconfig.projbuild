menu "FakePodNanoNightPlayer 应用配置"

    config TOUCH_TEST
        bool "触摸区域测试（白色圆点）"
        default y
        help
            启用后，显示一个 20px 白色圆点跟随手指移动，
            抬起后 1 秒内渐变消失，用于触摸区域调试。

    config PERFORMANCE_MONITOR
        bool "双核 CPU/内存性能监视（串口每 2s 输出）"
        default y
        help
            启用后启动 mem_monitor 后台任务，每 2 秒在串口打印：默认堆/内部
            RAM 剩余及增量、双核 CPU 使用率、当前与空闲期 CPU 频率（用于
            验证息屏降频生效，见 core/utils/power_service）。依赖
            CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS（已在 sdkconfig.defaults 开启）。
            关闭可减小固件并省掉监视任务占用的内存（约 5KB 任务栈）。

    config UI_SYSTEM_FONT_FULL
        bool "系统默认字体使用完整版（编译进固件，体积大）"
        default y
        help
            开启：把完整版 system_global_font 编译进固件
                  （字体数据约 2.4MB，含全量中文/日文/阿拉伯文/藏文等，
                   固件约 4.1MB、烧录慢），启动时经 SPIRAM_RODATA 复制进
                   PSRAM 约 2.6MB；正常使用。
            关闭：始终使用精简版 system_global_font_lite
                  （仅含系统 UI 所需文字 + ASCII，固件小、烧录快，适合调试；
                   注意音乐文件名等用户数据的汉字不在精简字体内）。

    config UI_COVER_FLASH
        bool "默认封面使用极速版（RGB565 真彩色，体积大）"
        default n
        help
            开启：默认封面引用 RGB565 真彩色版 default_cover_flash
                  （460x460 ≈ 423KB，与屏幕像素格式一致，LVGL 渲染走
                   快速路径，滑动翻页流畅，适合正式使用）。
            关闭：使用 2bit 索引色版 default_cover（约 52KB，省 Flash，
                  但渲染需逐像素查调色板，滑动时略卡，适合调试）。

    config BUTTON_LONG_PRESS_MS
        int "A 键长按触发伪关机的阈值（毫秒）"
        default 1200
        range 500 5000
        help
            A 键（GPIO48，与电源侧 3 秒关机芯片复用）按住超过该时长，
            固件主动伪关机（保存配置、停外设、定格提示后 deepsleep）。
            阈值须明显小于 3000ms（硬件断电时间），给保存/停外设留出窗口。
            曾用 2000ms 实测偶发"按了却没触发"（按满 3s 直接硬件断电，
            提示一闪而过），默认改为 1200ms 便于观察提示画面。
            ⚠ 仅影响 A 键；B 键（GPIO0）长按阈值固定 600ms
            （见 button_service.c 的 BUTTON_B_LONG_PRESS_MS）。

    config PAUSE_AUTO_SHUTDOWN_MIN
        int "息屏暂停超时自动伪关机（分钟，0=关闭）"
        default 10
        range 0 60
        help
            设备处于**息屏且暂停**状态持续超过该时长，自动伪关机省电
            （deepsleep，B 键/双按唤醒重启）。亮屏时暂停不计时（用户在看
            屏幕随时会操作）。伪关机前会记录播放状态（config_store 的
            was_playing），开机按记忆恢复：关机前在播放 → 开机自动播放；
            关机前已暂停 → 开机停在暂停态不自动出声。0 = 关闭该功能。

    config LOW_BATTERY_SHUTDOWN_SEC
        int "电池电压持续过低自动伪关机（秒，0=关闭）"
        default 60
        range 0 600
        help
            运行中（无论屏幕亮暗、是否播放）电池电压**持续**低于临界值
            3.2V（BATTERY_CRITICAL_LOW_MV，与开机拒启同一阈值，见
            core/hardware/battery.h）超过该时长，自动伪关机防过放
            （deepsleep，B 键唤醒重启）。时间窗口兼作滤波，滤除播放瞬时
            大电流压降与 ADC 抖动；期间任一采样恢复即清零重计。
            0 = 关闭该功能。⚠ 本固件暂无充电检测：充电器接入时电压被抬高
            （高于 3.2V）不会触发；若后续接入充电状态检测，应排除充电态。

    config BATTERY_LOGGER_MIN
        int "电池电压采样日志间隔（分钟，0=关闭）"
        default 5
        range 0 120
        help
            测试/功耗测量用：启用后独立任务每 N 分钟唤醒一次，在 10 秒
            窗口内以 1s 间隔读取 10 次电池电压，去掉一个最高/最低值后求
            平均，把"开机运行时长时间戳 + 平均电压"追加写入 SD 卡
            /sdcard/battery_log.txt（CSV 文本，追加累积不新建；每次开机
            先写一行会话分隔行，文件为空时自动写表头）。
            ⚠ 设备无 RTC/网络时钟，时间戳是开机以来的运行时长（非墙上
            时间），用于单次放电/功耗曲线分析；每 5 分钟仅写几十字节，
            对功耗测量影响可忽略。测试完建议设 0 关闭，避免持续占用
            SD 空间。依赖 SD 卡挂载，未插卡时任务跳过写入。

    config FIRMWARE_VERSION_STRING
        string "固件版本号（显示在设置-关于页末尾）"
        default "0.9.0.0 alpha 1"
        help
            用户可见的固件版本标识，仅用于"关于"页展示，不影响功能。
            发版时在此修改版本号即可。

endmenu
