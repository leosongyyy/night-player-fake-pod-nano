# ============================================================================
# font 维度 = ttffont（idfc 配置矩阵 overlay 配置）—— 默认类型
# ----------------------------------------------------------------------------
# 用途：界面字体走 **TTF + FreeType**。core/fonts/font_ttf.c 从 flash 的 font
#       分区（partitions.csv，裸二进制 4MiB）读 spiffs/system.ttf
#       （Droid Sans Fallback），按需光栅化；字体是**延迟加载**的——只有
#       boot_flow 判定"确实要进常规界面"时才加载（见 FontSystem.md §9 第 8 条）。
#
# 合并顺序（由 idfc 配置矩阵决定）：
#   sdkconfig.defaults                       （BaseConfig，公共配置）
#   sdkconfig.defaults.<variant>             （debug / releasecandidate / release）
#   sdkconfig.font.<类型>  ← 本文件           （Overlay）
#   sdkconfig.dac_chip.<类型>                 （Overlay，维度顺序见 BUILD_MATRIX.md §2.4）
#
# 使用方式：idfc_buildconfig.json → Overlays → font → 类型 ttffont 的 ConfigFile。
#   构建产物目录：build/{dac_chip}.{font}.{variant}（如 build/cs43131.ttffont.debug）
#   临时切换：idfc build -o font=binfont
#   永久切换：idfc set-overlay font binfont（清除：idfc set-overlay font --default）
#
# ⚠ 与 binfont 的差别（用户可见）：
#   · 体积：本类型 app 约 1.9MB（字体在 font 分区里，不占 app 分区）；
#           binfont 把整份位图字库编进固件，app 会大得多（见 BUILD_CONFIG.md）。
#   · 显示：TTF 能显示任意汉字/日文/生僻字（歌曲名、目录名全靠它）；
#           binfont 只能显示字库里列出的字，用户数据会缺字变方框。
#   · 烧录：本类型**字体不在固件里**，刷完固件还要用 esptool 手动刷一遍 font 分区
#           （esptool.exe --chip esp32s3 -p COMx write_flash 0x800000 spiffs/system.ttf，
#            见 ideas_and_exps/FONT_FLASH.md）；binfont 不占 font 分区，没有这一步。
# ⚠ font 分区在 binfont 下是**闲置**的（分区表共享，不随维度变化）——不影响功能。
#
# ⚠ 这几个开关与 sdkconfig.defaults 里的默认值一致，这里显式重复一遍是为了让
#   "本维度选了什么"一眼可见（dac_chip 的两个 overlay 也是这个风格）。
#   ⚠ 千万不要只把 FreeType 那几项挪到本文件、把默认值从 sdkconfig.defaults 删掉：
#     矩阵文件丢失时会回退"隐式矩阵"（BUILD_MATRIX.md §2.8），此时 overlay 不生效，
#     而 defaults 里若仍留着 CONFIG_UI_FONT_TTF=y 就会撞上 font_ttf.c 的
#     #error "CONFIG_UI_FONT_TTF=y 需要 CONFIG_LV_USE_FREETYPE=y"。
# ============================================================================

CONFIG_UI_FONT_TTF=y
# CONFIG_UI_SYSTEM_FONT_FULL is not set

# FreeType 引擎（TTF 渲染必需；binfont 类型会整组关掉以省 flash 与 RAM）
CONFIG_LV_USE_FREETYPE=y
CONFIG_LV_FREETYPE_USE_LVGL_PORT=y
CONFIG_LV_FREETYPE_CACHE_FT_GLYPH_CNT=1024
