# ============================================================================
# dac_chip 维度 = cs43131（idfc 配置矩阵 overlay 配置）
# ----------------------------------------------------------------------------
# 用途：声明音频 DAC 使用板载 CS43131（I2C 控制端口 0x30 + I2S 从机接收音频），
#       即当前 FakePodNano 成品机的真实硬件，也是公共默认（sdkconfig.defaults）
#       已经选中的那一项。本文件用于把"选中的维度类型"显式写清楚。
#
# 合并顺序（由 idfc 配置矩阵决定）：
#   sdkconfig.defaults                       （BaseConfig，公共配置）
#   sdkconfig.defaults.<variant>             （debug / releasecandidate / release）
#   sdkconfig.dac_chip.<类型>  ← 本文件       （Overlay，最后叠加、可覆盖前两者）
#
# 使用方式：idfc_buildconfig.json → Overlays → dac_chip → 类型 cs43131 的
#          ConfigFile 字段。构建产物目录为 build/{dac_chip}.{variant}
#          （如 build/cs43131.debug）。
#
# ⚠ 目前**尚未实现真正的 DAC 切换**：本文件不改变任何驱动或初始化行为，
#   只决定 main/main.c 的 app_main 结尾打印哪一行日志——
#   选本文件时应看到：DAC chip: CS43131 (build-time selection only, real
#   switching not implemented)。真正的切换（PCM5102 无 I2C 控制路径等）待实现。
# ⚠ AUDIO_DAC_CS43131 与 AUDIO_DAC_PCM5102 是**独立**的 bool，必须且只能开一个：
#   同时开启或同时关闭都会在编译期报错（#error，见 main/main.c 末尾）。
# ============================================================================

CONFIG_AUDIO_DAC_CS43131=y
# CONFIG_AUDIO_DAC_PCM5102 is not set
